model MedicalRecord {
    id                 String            @id @default(auto()) @map("_id") @db.ObjectId
    bookingId          String?           @unique @db.ObjectId  
    organizerRequestId String?           @db.ObjectId          
    driverId           String            @db.ObjectId
    clinicId           String            @db.ObjectId
    result             MedicalResult     @default(Pending)
    files              String?
    notes              String?
    expiryDate         DateTime?
    createdAt          DateTime          @default(now())
    updatedAt          DateTime          @updatedAt
    // relation
    booking            Booking?          @relation(fields: [bookingId], references: [id])     
    organizerRequest   OrganizerRequest? @relation(fields: [organizerRequestId], references: [id])
    driver             User              @relation("DriverMedicalRecords", fields: [driverId], references: [id])
    clinic             User              @relation(fields: [clinicId], references: [id])

    @@index([driverId])
    @@index([clinicId])
    @@index([driverId, createdAt])
    @@map("medical_records")
}
enum MedicalResult {
    Pending
    Submitted
}

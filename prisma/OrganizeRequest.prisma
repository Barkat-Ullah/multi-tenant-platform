model OrganizerRequest {
    id             String                   @id @default(auto()) @map("_id") @db.ObjectId
    userId         String                   @db.ObjectId
    serviceId      String                   @db.ObjectId
    clinicId       String?                  @db.ObjectId
    companyName    String
    email          String
    phone          String
    location       String
    totalDriver    String
    status         Status                   @default(Pending)
    isDeleted      Boolean                  @default(false)
    createdAt      DateTime                 @default(now())
    updatedAt      DateTime                 @updatedAt
    // relation
    organizer      User                     @relation("OrganizerRequestServices", fields: [userId], references: [id])
    clinic         User?                    @relation("clinicsView", fields: [clinicId], references: [id])
    service        Service                  @relation(fields: [serviceId], references: [id])
    drivers        OrganizerRequestDriver[]
    medicalRecords MedicalRecord[]

    @@map("OrganizerRequest")
}

model OrganizerRequestDriver {
    id                 String           @id @default(auto()) @map("_id") @db.ObjectId
    organizerRequestId String           @db.ObjectId
    driverId           String           @db.ObjectId
    createdAt          DateTime         @default(now())
    // relation
    organizerRequest   OrganizerRequest @relation(fields: [organizerRequestId], references: [id], onDelete: Cascade)
    driver             User             @relation("RequestedDrivers", fields: [driverId], references: [id])

    @@unique([organizerRequestId, driverId])
    @@map("organizer_request_drivers")
}

enum Status {
    Pending
    Confirmed
    Canceled
}
